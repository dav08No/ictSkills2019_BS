<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.appdev_nocito_davide.TournamentListController">
    <top>
        <ImageView fitHeight="62.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="TOP_LEFT">
            <image>
                <Image url="@header.png" />
            </image>
        </ImageView>
    </top>
    <bottom>
        <HBox prefHeight="43.0" prefWidth="572.0" spacing="12.0" BorderPane.alignment="CENTER_LEFT">
            <children>
                <Button fx:id="view" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="29.0" prefWidth="82.0" text="View" />
                <Region prefHeight="43.0" prefWidth="347.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="addTournament" mnemonicParsing="false" text="+ Tournament" onAction="#onAddTournament"/>
            </children>
            <padding>
                <Insets top="10.0" />
            </padding>
        </HBox>
    </bottom>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
   <center>
      <TableView fx:id="tournamentTable" minWidth="-Infinity" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="title" editable="false" minWidth="-1.0" prefWidth="75.0" text="Title" />
          <TableColumn fx:id="game" editable="false" prefWidth="75.0" text="Game" />
            <TableColumn fx:id="winner" editable="false" prefWidth="75.0" text="Winner" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
