<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.appdev_nocito_davide.MatchCardController">

    <padding>
        <Insets top="6" right="6" bottom="6" left="6"/>
    </padding>
    <top>
        <Label fx:id="matchTitleLabel"
               text="Match 1.1"
               style="-fx-font-size: 14px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER_LEFT"/>
    </top>
    <center>
        <VBox spacing="4">
            <BorderPane style="-fx-border-color: #777777; -fx-border-width: 1; -fx-padding: 8;">
                <left>
                    <VBox spacing="4" BorderPane.alignment="CENTER_LEFT">
                        <HBox spacing="4">
                            <Button fx:id="leftWButton"
                                    text="W"
                                    onAction="#onLeftW"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Button fx:id="leftLButton"
                                    text="L"
                                    onAction="#onLeftL"
                                    style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                        <HBox spacing="4">
                            <Label fx:id="leftResultLabel"
                                   text=""
                                   visible="false"
                                   managed="false"
                                   style="-fx-font-weight: bold; -fx-text-fill: #000000;"/>
                        </HBox>
                        <Label fx:id="leftNameLabel" text="Left"
                               style="-fx-font-size: 12px;"/>
                    </VBox>
                </left>
                <center>
                    <Label text="VS"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;"
                           BorderPane.alignment="CENTER"/>
                </center>
                <right>
                    <VBox spacing="4" BorderPane.alignment="CENTER_RIGHT">
                        <HBox spacing="4">
                            <Button fx:id="rightWButton"
                                    text="W"
                                    onAction="#onRightW"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Button fx:id="rightLButton"
                                    text="L"
                                    onAction="#onRightL"
                                    style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                        <HBox spacing="4">
                            <Label fx:id="rightResultLabel"
                                   text=""
                                   visible="false"
                                   managed="false"
                                   style="-fx-font-weight: bold; -fx-text-fill: #000000;"/>
                        </HBox>
                        <Label fx:id="rightNameLabel" text="Right"
                               style="-fx-font-size: 12px;"/>
                    </VBox>
                </right>
            </BorderPane>
        </VBox>
    </center>
</BorderPane>
